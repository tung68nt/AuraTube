<Application x:Class="AuraTube.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:AuraTube.Models"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="BgBrush" Color="#0F0F12"/>
            <SolidColorBrush x:Key="SurfaceBrush" Color="#1A1A1F"/>
            <SolidColorBrush x:Key="Surface2Brush" Color="#26262D"/>
            <SolidColorBrush x:Key="HoverBrush" Color="#2F2F38"/>
            <SolidColorBrush x:Key="TextBrush" Color="#F2F2F5"/>
            <SolidColorBrush x:Key="SubTextBrush" Color="#A0A0AB"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF2D55"/>
            <SolidColorBrush x:Key="BorderBrush" Color="#33333B"/>
            <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
            </Style>

            <Style x:Key="SubText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource SubTextBrush}"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            </Style>

            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <!-- Flat pill button -->
            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="{StaticResource Surface2Brush}"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"/></ContentPresenter.Resources></ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <Style x:Key="IconButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
                <Setter Property="FontSize" Value="16"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="19">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"/></ContentPresenter.Resources></ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Sidebar navigation item -->
            <Style x:Key="NavButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Margin" Value="8,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="GroupName" Value="nav"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="10" Padding="12,9">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Icon}" Margin="0,0,14,0"/>
                                    <ContentPresenter VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"/></ContentPresenter.Resources></ContentPresenter>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource HoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Surface2Brush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="ChipButton" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="b" Background="{StaticResource Surface2Brush}" CornerRadius="8" Padding="12,6">
                                <ContentPresenter VerticalAlignment="Center"><ContentPresenter.Resources><Style TargetType="TextBlock"/></ContentPresenter.Resources></ContentPresenter>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource TextBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource BgBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TextBox" x:Key="SearchBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
                <Setter Property="Margin" Value="0,6"/>
            </Style>

            <Style TargetType="ScrollViewer">
                <Setter Property="PanningMode" Value="VerticalOnly"/>
            </Style>

            <!-- Video card used by every grid -->
            <DataTemplate x:Key="VideoCard" DataType="{x:Type m:Video}">
                <Border Width="300" Margin="8,8,8,16" Background="Transparent" Cursor="Hand" Tag="{Binding}">
                    <StackPanel>
                        <Grid>
                            <Border CornerRadius="12" ClipToBounds="True" Height="169" Background="{StaticResource SurfaceBrush}">
                                <Border.OpacityMask>
                                    <VisualBrush>
                                        <VisualBrush.Visual>
                                            <Border Width="300" Height="169" CornerRadius="12" Background="Black"/>
                                        </VisualBrush.Visual>
                                    </VisualBrush>
                                </Border.OpacityMask>
                                <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Border Background="#CC000000" CornerRadius="5" Padding="5,1" Margin="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasDuration}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding DurationFormatted}" FontSize="12" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top" Fill="{StaticResource Surface2Brush}"/>
                            <Ellipse Width="34" Height="34" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding ChannelAvatarUrl, IsAsync=True, TargetNullValue={x:Null}, FallbackValue={x:Null}}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Uploader}" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubText}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="ShortCard" DataType="{x:Type m:Video}">
                <Border Width="170" Margin="6" Cursor="Hand" Tag="{Binding}">
                    <StackPanel>
                        <Border CornerRadius="12" Height="300" ClipToBounds="True" Background="{StaticResource SurfaceBrush}">
                            <Border.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="170" Height="300" CornerRadius="12" Background="Black"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                        <TextBlock Text="{Binding ViewCountFormatted}" Style="{StaticResource SubText}"/>
                    </StackPanel>
                </Border>
            </DataTemplate>

            <!-- Compact row for related videos -->
            <DataTemplate x:Key="VideoRow" DataType="{x:Type m:Video}">
                <Grid Margin="0,0,0,10" Cursor="Hand" Tag="{Binding}" Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="168"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid Height="94">
                        <Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource SurfaceBrush}">
                            <Border.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="168" Height="94" CornerRadius="8" Background="Black"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Border.OpacityMask>
                            <Image Source="{Binding Thumbnail, IsAsync=True}" Stretch="UniformToFill"/>
                        </Border>
                        <Border Background="#CC000000" CornerRadius="4" Padding="4,0" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock Text="{Binding DurationFormatted}" FontSize="11"/>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Uploader}" Style="{StaticResource SubText}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubText}"/>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
