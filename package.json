{
  "name": "auratube",
  "version": "1.0.0",
  "description": "Ad-free YouTube Client for Web and Desktop (macOS, Windows, Linux)",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "web": "node server.js",
    "desktop": "electron .",
    "dev": "node server.js",
    "build:app": "electron-packager . AuraTube --platform=darwin --arch=arm64 --icon=assets/icon --out=dist --overwrite && rm -rf /Applications/PureTube.app /Applications/AuraTube.app && cp -R dist/AuraTube-darwin-arm64/AuraTube.app /Applications/",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "keywords": [
    "youtube",
    "adfree",
    "electron",
    "ytdlp",
    "invidious"
  ],
  "author": "Tung Nguyen <tung68nt@users.noreply.github.com>",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "undici": "^8.10.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "homepage": "https://github.com/tung68nt/AuraTube",
  "build": {
    "appId": "com.auratube.desktop",
    "productName": "AuraTube",
    "artifactName": "AuraTube-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "server.js",
      "preload.js",
      "preload-mini.js",
      "public/**",
      "src/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AuraTube-${version}-win-x64-setup.${ext}"
    },
    "portable": {
      "artifactName": "AuraTube-${version}-win-x64-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Video",
      "icon": "assets/icon.png",
      "maintainer": "Tung Nguyen <tung68nt@users.noreply.github.com>"
    }
  }
}
